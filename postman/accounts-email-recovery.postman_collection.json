{
  "info": {
    "name": "Receipt API - Email Verification and Recovery (Manual)",
    "description": "Requires configured SMTP and a fresh recipientEmail mailbox/alias you control. Run one numbered folder at a time; pause between folders to copy the real verification and reset tokens from email. Do not run the full collection unattended. Each run creates then disables an account; use a new email alias on subsequent runs. Requests are paced to respect auth limits.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "recipientEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "verificationToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pace requests below the API's 30 authentication requests/minute per IP.",
          "setTimeout(() => {}, 2200);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Register and send verification",
      "item": [
        {
          "name": "01 - Register disposable email account",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{email}}\",\n  \"displayName\": \"Postman Account\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix=Date.now().toString(36)+Math.random().toString(36).slice(2,7);",
                  "pm.collectionVariables.set('username', 'pm_'+suffix);",
                  "pm.collectionVariables.set('email', 'pm_'+suffix+'@example.com');",
                  "pm.collectionVariables.set('password', 'Initial!'+pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('newPassword', 'Changed!'+pm.variables.replaceIn('{{$guid}}'));",
                  "['accessToken','accessRefresh','guestToken','guestRefresh','secondToken','secondRefresh','oldRefresh','userId','receiptId','friendId'].forEach(k=>pm.collectionVariables.unset(k));",
                  "const recipient=pm.collectionVariables.get('recipientEmail'); if(!recipient || recipient.endsWith('@example.com')) throw new Error('Set recipientEmail to a fresh mailbox/alias you control before running.');",
                  "pm.collectionVariables.set('email', pm.collectionVariables.get('recipientEmail'));",
                  "['verificationToken','resetToken'].forEach(k=>pm.collectionVariables.unset(k));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test(\"Credentials have the expected shape\", () => { const s=pm.response.json(); pm.expect(s.accessToken.split('.')).to.have.lengthOf(3); pm.expect(s.refreshToken).to.be.a('string').and.not.empty; pm.expect(s.tokenType).to.eql('Bearer'); pm.expect(s.expiresIn).to.eql(900); pm.expect(s.user.id).to.be.a('number'); });",
                  "pm.test(\"Account does not expose secrets\", () => { const u=pm.response.json().user || pm.response.json(); ['password','passwordHash','googleSubject','refreshHash'].forEach(k => pm.expect(u).not.to.have.property(k)); });",
                  "if (pm.response.code === 201) {",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('accessRefresh', pm.response.json().refreshToken);",
                  "pm.collectionVariables.set('userId', pm.response.json().user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Send email verification",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/auth/email/send-verification",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Verify email (paste verificationToken first)",
      "description": "Wait for the verification email. Paste its one-time token into verificationToken, then run this folder only.",
      "item": [
        {
          "name": "03 - Verify email token",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/email/verify",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(!pm.collectionVariables.get('verificationToken')) throw new Error('Set verificationToken in collection variables from the email before running this folder.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Reject verification replay",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/email/verify",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Confirm verified email",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test(\"emailVerified\", () => { pm.expect(pm.response.json().emailVerified).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Request password reset",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/password/forgot",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Reset password (paste resetToken first)",
      "description": "Paste the password reset email token into resetToken, then run this folder only. This revokes sessions and finally disables the disposable account.",
      "item": [
        {
          "name": "07 - Reset password",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/password/reset",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(!pm.collectionVariables.get('resetToken')) throw new Error('Set resetToken in collection variables from the email before running this folder.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "08 - Reject reset replay",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/password/reset",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 - Reset revokes old access",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "10 - Reset revokes old refresh",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/refresh",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{accessRefresh}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "11 - Reject old password",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "12 - Login using reset password",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test(\"Credentials have the expected shape\", () => { const s=pm.response.json(); pm.expect(s.accessToken.split('.')).to.have.lengthOf(3); pm.expect(s.refreshToken).to.be.a('string').and.not.empty; pm.expect(s.tokenType).to.eql('Bearer'); pm.expect(s.expiresIn).to.eql(900); pm.expect(s.user.id).to.be.a('number'); });",
                  "pm.test(\"Account does not expose secrets\", () => { const u=pm.response.json().user || pm.response.json(); ['password','passwordHash','googleSubject','refreshHash'].forEach(k => pm.expect(u).not.to.have.property(k)); });",
                  "if (pm.response.code === 200) {",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('accessRefresh', pm.response.json().refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "13 - Deactivate disposable email account",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
