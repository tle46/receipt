{
  "info": {
    "_postman_id": "e5161b25-c0a2-40fb-8c42-bulk-draft-save",
    "name": "Receipt API - Bulk Draft Save Tests",
    "description": "Run top-to-bottom. Tests saving a complete draft in one request and transaction rollback for an invalid payload.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "01 - Create owner",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{ \"username\": \"{{ownerUsername}}\", \"email\": \"{{ownerEmail}}\" }" },
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "const suffix = Date.now();",
          "pm.collectionVariables.set('ownerUsername', `bulk_owner_${suffix}`);",
          "pm.collectionVariables.set('ownerEmail', `bulk_owner_${suffix}@example.com`);"
        ] } },
        { "listen": "test", "script": { "exec": [
          "pm.test('Owner created', () => pm.response.to.have.status(200));",
          "pm.collectionVariables.set('ownerId', pm.response.json().id);"
        ] } }
      ]
    },
    {
      "name": "02 - Create friend",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{ \"username\": \"{{friendUsername}}\", \"email\": \"{{friendEmail}}\" }" },
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "const suffix = Date.now();",
          "pm.collectionVariables.set('friendUsername', `bulk_friend_${suffix}`);",
          "pm.collectionVariables.set('friendEmail', `bulk_friend_${suffix}@example.com`);"
        ] } },
        { "listen": "test", "script": { "exec": [
          "pm.test('Friend created', () => pm.response.to.have.status(200));",
          "pm.collectionVariables.set('friendId', pm.response.json().id);"
        ] } }
      ]
    },
    {
      "name": "03 - Create seed receipt",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"merchantName\": \"Seed receipt\",\n  \"discount\": 0.00,\n  \"tax\": 0.00,\n  \"fee\": 0.00,\n  \"tip\": 0.00,\n  \"currency\": \"USD\",\n  \"total\": 1.00,\n  \"items\": [{ \"name\": \"Seed item\", \"quantity\": 1, \"unitPrice\": 1.00, \"total\": 1.00 }]\n}" },
        "url": "{{baseUrl}}/api/receipts?userId={{ownerId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Seed receipt created', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('receiptId', pm.response.json().id);"
      ] } }]
    },
    {
      "name": "04 - Save complete draft in one request",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"merchantName\": \"Bulk Bistro\",\n  \"purchaseDate\": \"2026-09-30T18:00:00\",\n  \"discount\": 0.00,\n  \"tax\": 1.00,\n  \"fee\": 0.00,\n  \"tip\": 0.00,\n  \"currency\": \"USD\",\n  \"participantUserIds\": [{{friendId}}],\n  \"items\": [\n    {\n      \"name\": \"Pizza\",\n      \"quantity\": 1,\n      \"unitPrice\": 10.00,\n      \"allocations\": [\n        { \"userId\": {{ownerId}}, \"allocationType\": \"EXACT\", \"inputValue\": 6.00 },\n        { \"userId\": {{friendId}}, \"allocationType\": \"EXACT\", \"inputValue\": 4.00 }\n      ]\n    },\n    {\n      \"name\": \"Salad\",\n      \"quantity\": 1,\n      \"unitPrice\": 5.00,\n      \"allocations\": [\n        { \"userId\": {{friendId}}, \"allocationType\": \"EXACT\", \"inputValue\": 5.00 }\n      ]\n    }\n  ]\n}" },
        "url": "{{baseUrl}}/api/receipts/{{receiptId}}/draft?userId={{ownerId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Bulk draft save succeeds', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('Entire draft is returned', () => {",
        "  pm.expect(body.merchantName).to.eql('Bulk Bistro');",
        "  pm.expect(body.participants).to.have.length(2);",
        "  pm.expect(body.items).to.have.length(2);",
        "  pm.expect(body.items[0].allocations).to.have.length(2);",
        "  pm.expect(body.items[1].allocations).to.have.length(1);",
        "});"
      ] } }]
    },
    {
      "name": "05 - Calculate the saved draft",
      "request": { "method": "POST", "url": "{{baseUrl}}/api/receipts/{{receiptId}}/calculate?userId={{ownerId}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Calculation succeeds', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('Receipt total is $16', () => pm.expect(Number(body.total)).to.eql(16));",
        "pm.test('Participant balances total $16', () => {",
        "  const total = body.participants.reduce((sum, participant) => sum + Number(participant.finalOwedAmount), 0);",
        "  pm.expect(total).to.eql(16);",
        "});"
      ] } }]
    },
    {
      "name": "06 - Reject invalid bulk draft",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"merchantName\": \"This must not save\",\n  \"discount\": 0.00,\n  \"tax\": 0.00,\n  \"fee\": 0.00,\n  \"tip\": 0.00,\n  \"currency\": \"USD\",\n  \"participantUserIds\": [{{friendId}}],\n  \"items\": [{\n    \"name\": \"Invalid item\",\n    \"quantity\": 1,\n    \"unitPrice\": 5.00,\n    \"allocations\": [{ \"userId\": 999999999, \"allocationType\": \"EXACT\", \"inputValue\": 5.00 }]\n  }]\n}" },
        "url": "{{baseUrl}}/api/receipts/{{receiptId}}/draft?userId={{ownerId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Invalid bulk draft is rejected', () => pm.response.to.have.status(400));",
        "pm.test('Standard error body is returned', () => pm.expect(pm.response.json().message).to.include('allocation user'));"
      ] } }]
    },
    {
      "name": "07 - Verify invalid draft rolled back",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/receipts/{{receiptId}}?userId={{ownerId}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Existing draft remains readable', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('Original bulk draft was not overwritten', () => {",
        "  pm.expect(body.merchantName).to.eql('Bulk Bistro');",
        "  pm.expect(body.items).to.have.length(2);",
        "});"
      ] } }]
    }
  ]
}
