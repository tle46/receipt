{
  "info": {
    "_postman_id": "e5161b25-c0a2-40fb-8c42-bulk-draft-save",
    "name": "Receipt API - Bulk Draft Save Tests",
    "description": "Run top-to-bottom against a development database. Creates owner and participant guest sessions, stores IDs and tokens, and authenticates receipt requests as the owner. Re-run from the start if the access token expires.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 - Create owner guest session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": "{{baseUrl}}/api/auth/guest",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "script": {
            "exec": [
              "pm.test('Guest created', () => pm.response.to.have.status(201));",
              "const session = pm.response.json();",
              "pm.collectionVariables.set('ownerId', session.user.id);",
              "pm.collectionVariables.set('ownerAccessToken', session.accessToken);"
            ]
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "02 - Create friend guest session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": "{{baseUrl}}/api/auth/guest",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "script": {
            "exec": [
              "pm.test('Guest created', () => pm.response.to.have.status(201));",
              "const session = pm.response.json();",
              "pm.collectionVariables.set('friendId', session.user.id);",
              "pm.collectionVariables.set('friendAccessToken', session.accessToken);"
            ]
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "03 - Create seed receipt",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantName\": \"Seed receipt\",\n  \"discount\": 0.00,\n  \"tax\": 0.00,\n  \"fee\": 0.00,\n  \"tip\": 0.00,\n  \"currency\": \"USD\",\n  \"total\": 1.00,\n  \"items\": [{ \"name\": \"Seed item\", \"quantity\": 1, \"unitPrice\": 1.00, \"total\": 1.00 }]\n}"
        },
        "url": "{{baseUrl}}/api/receipts?userId={{ownerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Seed receipt created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('receiptId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Save complete draft in one request",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantName\": \"Bulk Bistro\",\n  \"purchaseDate\": \"2026-09-30T18:00:00\",\n  \"discount\": 0.00,\n  \"tax\": 1.00,\n  \"fee\": 0.00,\n  \"tip\": 0.00,\n  \"currency\": \"USD\",\n  \"participantUserIds\": [{{friendId}}],\n  \"items\": [\n    {\n      \"name\": \"Pizza\",\n      \"quantity\": 1,\n      \"unitPrice\": 10.00,\n      \"allocations\": [\n        { \"userId\": {{ownerId}}, \"allocationType\": \"EXACT\", \"inputValue\": 6.00 },\n        { \"userId\": {{friendId}}, \"allocationType\": \"EXACT\", \"inputValue\": 4.00 }\n      ]\n    },\n    {\n      \"name\": \"Salad\",\n      \"quantity\": 1,\n      \"unitPrice\": 5.00,\n      \"allocations\": [\n        { \"userId\": {{friendId}}, \"allocationType\": \"EXACT\", \"inputValue\": 5.00 }\n      ]\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/receipts/{{receiptId}}/draft?userId={{ownerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Bulk draft save succeeds', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Entire draft is returned', () => {",
              "  pm.expect(body.merchantName).to.eql('Bulk Bistro');",
              "  pm.expect(body.participants).to.have.length(2);",
              "  pm.expect(body.items).to.have.length(2);",
              "  pm.expect(body.items[0].allocations).to.have.length(2);",
              "  pm.expect(body.items[1].allocations).to.have.length(1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Calculate the saved draft",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/receipts/{{receiptId}}/calculate?userId={{ownerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Calculation succeeds', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Receipt total is $16', () => pm.expect(Number(body.total)).to.eql(16));",
              "pm.test('Participant balances total $16', () => {",
              "  const total = body.participants.reduce((sum, participant) => sum + Number(participant.finalOwedAmount), 0);",
              "  pm.expect(total).to.eql(16);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Reject invalid bulk draft",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantName\": \"This must not save\",\n  \"discount\": 0.00,\n  \"tax\": 0.00,\n  \"fee\": 0.00,\n  \"tip\": 0.00,\n  \"currency\": \"USD\",\n  \"participantUserIds\": [{{friendId}}],\n  \"items\": [{\n    \"name\": \"Invalid item\",\n    \"quantity\": 1,\n    \"unitPrice\": 5.00,\n    \"allocations\": [{ \"userId\": 999999999, \"allocationType\": \"EXACT\", \"inputValue\": 5.00 }]\n  }]\n}"
        },
        "url": "{{baseUrl}}/api/receipts/{{receiptId}}/draft?userId={{ownerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Invalid bulk draft is rejected', () => pm.response.to.have.status(400));",
              "pm.test('Standard error body is returned', () => pm.expect(pm.response.json().message).to.include('allocation user'));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Verify invalid draft rolled back",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/receipts/{{receiptId}}?userId={{ownerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Existing draft remains readable', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Original bulk draft was not overwritten', () => {",
              "  pm.expect(body.merchantName).to.eql('Bulk Bistro');",
              "  pm.expect(body.items).to.have.length(2);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "type": "string",
        "value": "{{ownerAccessToken}}",
        "key": "token"
      }
    ]
  }
}
