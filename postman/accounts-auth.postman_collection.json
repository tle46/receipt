{
  "info": {
    "name": "Receipt API - Accounts and Authentication",
    "description": "Run the entire collection top-to-bottom against a disposable development database. No Google or SMTP configuration needed. Generates unique credentials, upgrades a guest without losing its receipt, tests multiple sessions, rotation, revocation, contacts and actor authorization, then deactivates the account. Requests are paced 2.2 seconds apart to respect auth limits; allow about 2 minutes. Do not run concurrently with other auth collections. Tests create persistent disabled accounts and placeholder contacts; deactivation is not erasure. No secrets are shipped in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pace requests below the API's 30 authentication requests/minute per IP.",
          "setTimeout(() => {}, 2200);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Reject unauthenticated profile",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": "{{baseUrl}}/api/auth/me",
        "description": ""
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix=Date.now().toString(36)+Math.random().toString(36).slice(2,7);",
              "pm.collectionVariables.set('username', 'pm_'+suffix);",
              "pm.collectionVariables.set('email', 'pm_'+suffix+'@example.com');",
              "pm.collectionVariables.set('password', 'Initial!'+pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('newPassword', 'Changed!'+pm.variables.replaceIn('{{$guid}}'));",
              "['accessToken','accessRefresh','guestToken','guestRefresh','secondToken','secondRefresh','oldRefresh','userId','receiptId','friendId'].forEach(k=>pm.collectionVariables.unset(k));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Create guest",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": "{{baseUrl}}/api/auth/guest",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test(\"Credentials have the expected shape\", () => { const s=pm.response.json(); pm.expect(s.accessToken.split('.')).to.have.lengthOf(3); pm.expect(s.refreshToken).to.be.a('string').and.not.empty; pm.expect(s.tokenType).to.eql('Bearer'); pm.expect(s.expiresIn).to.eql(900); pm.expect(s.user.id).to.be.a('number'); });",
              "pm.test(\"Account does not expose secrets\", () => { const u=pm.response.json().user || pm.response.json(); ['password','passwordHash','googleSubject','refreshHash'].forEach(k => pm.expect(u).not.to.have.property(k)); });",
              "if (pm.response.code === 201) {",
              "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
              "pm.collectionVariables.set('accessRefresh', pm.response.json().refreshToken);",
              "pm.collectionVariables.set('userId', pm.response.json().user.id);",
              "pm.collectionVariables.set('guestToken', pm.response.json().accessToken);",
              "pm.collectionVariables.set('guestRefresh', pm.response.json().refreshToken);",
              "}",
              "pm.test(\"user.status\", () => { pm.expect(pm.response.json().user.status).to.eql('GUEST'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Read guest profile",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/auth/me",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test(\"id\", () => { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('userId'))); });",
              "pm.test(\"status\", () => { pm.expect(pm.response.json().status).to.eql('GUEST'); });",
              "pm.test(\"Account does not expose secrets\", () => { const u=pm.response.json().user || pm.response.json(); ['password','passwordHash','googleSubject','refreshHash'].forEach(k => pm.expect(u).not.to.have.property(k)); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Create receipt as guest",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/receipts?userId={{userId}}",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantName\": \"Auth retention test\",\n  \"currency\": \"USD\",\n  \"discount\": 0,\n  \"tax\": 0,\n  \"fee\": 0,\n  \"tip\": 0,\n  \"total\": 10,\n  \"items\": [\n    {\n      \"name\": \"Meal\",\n      \"quantity\": 1,\n      \"unitPrice\": 10,\n      \"total\": 10\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test(\"ownerId\", () => { pm.expect(pm.response.json().ownerId).to.eql(Number(pm.collectionVariables.get('userId'))); });",
              "if(pm.response.code===201) pm.collectionVariables.set('receiptId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
