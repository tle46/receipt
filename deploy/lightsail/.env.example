# Copy to .env on the server; chmod 600 .env. Never commit the real values.
APP_VERSION=release-1
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com
CORS_ALLOWED_ORIGIN=https://app.example.com
# Generate independently with openssl rand -base64 32 on Linux.
DB_PASSWORD=
AUTH_JWT_SECRET=
GOOGLE_CLIENT_ID=
# Fresh DB only: update during private bootstrap; change to validate before exposing API.
SCHEMA_MODE=validate
